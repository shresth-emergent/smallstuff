{
  "manifest_version": 3,
  "name": "GitHub PR Focus",
  "version": "0.2.0",
  "description": "Hide test files and source-code comments while reading GitHub pull request diffs.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["src/filters.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ]
}
